rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // WORKHUB / SAAS PRODUCTION SECURE FIRESTORE RULES
    // Role-Based Access Control & Strict Data Integrity
    // ═══════════════════════════════════════════════════════════

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role check helper via user doc or custom claims
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role in ['admin', 'superAdmin']) ||
        (exists(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email.lower())) &&
         get(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email.lower())).data.status == 'active') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role in ['admin', 'superAdmin'] &&
         getUserData().status == 'active')
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superAdmin' ||
        (exists(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email.lower())) &&
         get(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email.lower())).data.role == 'superAdmin' &&
         get(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email.lower())).data.status == 'active') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'superAdmin' &&
         getUserData().status == 'active')
      );
    }

    // ── 1. USERS COLLECTION ────────────────────────────────────
    match /users/{userId} {
      // Authenticated users can read their own profile or any employee profile for collaboration
      // Sensitive fields like passwordHash and salt are restricted from normal reads in app logic
      allow read: if isAuthenticated();

      // Creation: Admins or initial signup
      allow create: if isAuthenticated();

      // Updates: Admins can update anything; Users can only update safe profile fields (not role, oCoinsBalance, permissions, status)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isUser(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'status', 'oCoinsBalance']))
      );

      // Deletions: Super Admins only
      allow delete: if isSuperAdmin();
    }

    // ── 2. AUTHORIZED ADMINS (Whitelist) ────────────────────────
    match /authorized_admins/{adminEmail} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ── 3. AUTHORIZED USERS (Legacy Whitelist) ──────────────────
    match /authorizedUsers/{userEmail} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── 4. TASKS COLLECTION ─────────────────────────────────────
    match /tasks/{taskId} {
      // Admins read all; Employees read if assigned, creator, or authenticated employee
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      
      // Admins update all; Employees can update their userStatuses / latestSubmission
      allow update: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userStatuses', 'latestSubmission', 'updatedAt'])
      );

      match /submissions/{submissionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          request.resource.data.submittedBy == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    // ── 5. O COINS LEDGER & TRANSACTIONS ────────────────────────
    match /oCoins/{transactionId} {
      // Users can read own transactions; Admins read all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.uid == request.auth.uid ||
        resource.data.employeeId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email
      );
      // Only admins or system transactions
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.type in ['discount_purchase', 'task_submitted']
      );
      allow update, delete: if isAdmin();
    }

    // ── 6. SUPPORT TICKETS ──────────────────────────────────────
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.creatorEmail == request.auth.token.email
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.createdBy == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastMessageAt', 'repliesCount']))
      );
      allow delete: if isAdmin();
    }

    match /supportTicketMessages/{messageId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (!resource.data.isInternalNote && resource.data.ticketCreatedBy == request.auth.uid) ||
        resource.data.senderId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ── 7. ATTENDANCE SESSIONS & RECORDS ────────────────────────
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /attendance_records/{recordId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.employeeId == request.auth.uid
      );
      // Employees can check-in (create own record with atomic ID session_uid)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.employeeId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ── 8. MEETINGS ─────────────────────────────────────────────
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── 9. BANS & SUSPENSIONS ───────────────────────────────────
    match /bans/{banId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.employeeId == request.auth.uid
      );
      allow write: if isAdmin();
    }

    // ── 10. COMMITTEES ──────────────────────────────────────────
    match /committees/{committeeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── 11. OPPORTUNITIES & TRAINING ────────────────────────────
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── 12. COURSES, LESSONS & PROGRESS ─────────────────────────
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /course_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /course_progress/{progressId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ── 13. DISCOUNTS & PURCHASES ───────────────────────────────
    match /discounts/{discountId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /discount_purchases/{purchaseId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.employeeId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.employeeId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ── 14. NOTIFICATIONS ───────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.recipientUid == request.auth.uid ||
        resource.data.recipientEmail == request.auth.token.email
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.recipientUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.recipientUid == request.auth.uid
      );
    }

    // ── 15. ACTIVITY & AUDIT LOGS ───────────────────────────────
    match /activityLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ── 16. SYSTEM SETTINGS & MAINTENANCE ───────────────────────
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Deny anything unhandled by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
